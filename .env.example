# --- AI (OpenAI-compatible: DeepSeek / OpenAI / OpenRouter / Groq / Ollama) ---
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
# Image/video model. Empty = use AI_MODEL.
AI_VISION_MODEL=
# Output token limit per reply.
AI_MAX_TOKENS=2000
# Timeout per AI attempt (milliseconds).
AI_TIMEOUT_MS=20000

# DeepSeek enables thinking mode by default: slower and more expensive.
# off = cheapest. on = allow reasoning (smarter, higher token usage).
# auto = do not send any thinking parameter (use this for other providers).
AI_THINKING=off
# Reasoning effort when thinking is on: low / high / max.
AI_REASONING_EFFORT=low

# Your name, as it appears in the WhatsApp export.
MY_NAME=

# --- Dashboard ---
PORT=3000
# Safe default: local PC only. Use 0.0.0.0 only for explicit LAN access.
BIND_HOST=127.0.0.1
# Extra allowed hostnames, comma-separated.
# Empty = localhost + all machine IPs. Add entries for local DNS/hostnames.
ALLOWED_HOSTS=
# Absolute path for the SQLite database. Use a persistent disk in production.
DATA_DIR=./data
# For tests/CI: set to 1 to skip WhatsApp.
# WA_DISABLED=1
# Auto-import folder for chat exports.
IMPORT_INBOX=import-inbox

# --- Accounts and OAuth ---
# Public origin used for OAuth callbacks. Example: https://tutur.example.com
PUBLIC_BASE_URL=
# Google Cloud Console, OAuth client (Web application).
# Redirect URI: <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta for Developers, Facebook Login.
# Redirect URI: <PUBLIC_BASE_URL>/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Judge demo mode ---# 1 = Sari Kitchen demo, business prompt, no WhatsApp, admin token required.
DEMO_MODE=0
# Random string. Required when DEMO_MODE=1 for dashboard APIs.
ADMIN_TOKEN=
# Display name for the demo business.
BUSINESS_NAME=Sari Kitchen
# Name the AI writes as. Defaults to Sari in demo mode.
DEMO_OWNER=Sari
# Quiet hours must be off during judging so a test message is never ignored.
QUIET_HOURS=off

# --- Anti-ban guardrails (do not raise without a good reason) ---
MAX_MSGS_PER_DAY=40
MAX_MSGS_PER_HOUR=20
MIN_GAP_PER_CONTACT_SEC=10
AUTO_CONFIDENCE_MIN=0.55

# Simulated typing delay before sending (milliseconds).
REPLY_DELAY_MIN_MS=2000
REPLY_DELAY_MAX_MS=5000

# Wait briefly before replying so consecutive chat bubbles are merged.
# If the other person is still "typing", the wait is extended up to this limit.
DEBOUNCE_MS=3500
DEBOUNCE_MAX_WAIT_MS=15000

# --- Stickers (collected automatically from private chats) ---
STICKER_ENABLED=true
STICKER_CHANCE=0.5
STICKER_COOLDOWN_MIN=30
STICKER_EVERY=5

# --- Persona ---
FEWSHOT_COUNT=12
HISTORY_TURNS=10
AI_TEMPERATURE=1.0

# --- Voice note transcription ---
# Default: local Whisper (no account). The model is downloaded once (~150 MB).
# Use a larger model for better accuracy (slower):
#   Xenova/whisper-tiny | Xenova/whisper-base | Xenova/whisper-small
AI_TRANSCRIBE_LOCAL=true
AI_TRANSCRIBE_MODEL_LOCAL=Xenova/whisper-base

# For faster/online transcription, fill in an OpenAI/Groq-compatible endpoint.
# Local transcription is skipped when this is set.
AI_TRANSCRIBE_URL=
AI_TRANSCRIBE_KEY=
AI_TRANSCRIBE_MODEL=whisper-1

# --- Extra guard: numbers that must NEVER be answered (comma-separated) ---
VIP_NUMBERS=
