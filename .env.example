# --- AI (kompatibel OpenAI: DeepSeek / OpenAI / OpenRouter / Groq / Ollama) ---
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-flash
# Model khusus gambar/video. Kosong = ikut AI_MODEL.
AI_VISION_MODEL=
# Batas token output per balasan.
AI_MAX_TOKENS=2000
# Batas waktu satu panggilan AI (milidetik).
AI_TIMEOUT_MS=20000

# DeepSeek menyalakan "thinking mode" secara default: lebih mahal & lambat.
# off = paling murah. on = biarkan mikir (lebih pintar, lebih boros).
# auto = jangan kirim parameter apa pun (untuk provider lain).
AI_THINKING=off

# Nama kamu seperti yang muncul di export WhatsApp.
MY_NAME=

# --- Dashboard ---
PORT=3000
# Default aman: hanya PC ini. Ganti ke 0.0.0.0 kalau memang mau buka dari HP/LAN.
BIND_HOST=127.0.0.1
# Host tambahan yang boleh mengakses dashboard (pisahkan koma).
# Kosong = localhost + semua IP mesin. Isi kalau pakai hostname/DNS lokal.
ALLOWED_HOSTS=
# Untuk tes/CI: 1 = jangan connect ke WhatsApp.
# WA_DISABLED=1
# Folder auto-import export chat (default import-inbox).
IMPORT_INBOX=import-inbox

# --- Pagar anti-ban (jangan dinaikkan tanpa alasan kuat) ---
MAX_MSGS_PER_DAY=40
MAX_MSGS_PER_HOUR=20
MIN_GAP_PER_CONTACT_SEC=10
# Jam tenang: AI tidak membalas otomatis di rentang ini. Isi "off" untuk mematikan.
QUIET_HOURS=01:00-07:00
AUTO_CONFIDENCE_MIN=0.55

# Jeda "mengetik" sebelum kirim (milidetik).
REPLY_DELAY_MIN_MS=2000
REPLY_DELAY_MAX_MS=5000

# Tunggu dulu sebelum membalas, biar bubble chat yang bersambung digabung.
# Kalau lawan bicara masih "mengetik", waktu tunggu diperpanjang sampai batas ini.
DEBOUNCE_MS=3500
DEBOUNCE_MAX_WAIT_MS=15000

# --- Stiker (dikumpulkan otomatis dari chat pribadi) ---
STICKER_ENABLED=true
STICKER_CHANCE=0.5
STICKER_COOLDOWN_MIN=30

# --- Persona ---
FEWSHOT_COUNT=12
HISTORY_TURNS=10
AI_TEMPERATURE=1.0

# --- Transkrip pesan suara ---
# Default: Whisper lokal (tanpa akun). Model diunduh sekali ~150 MB.
# Ganti model kalau ingin lebih akurat (lebih besar/lambat):
#   Xenova/whisper-tiny | Xenova/whisper-base | Xenova/whisper-small
AI_TRANSCRIBE_LOCAL=true
AI_TRANSCRIBE_MODEL_LOCAL=Xenova/whisper-base

# Kalau mau lebih cepat & akurat, isi layanan online (OpenAI/Groq) dan
# transkrip lokal otomatis tidak dipakai.
AI_TRANSCRIBE_URL=
AI_TRANSCRIBE_KEY=
AI_TRANSCRIBE_MODEL=whisper-1

# --- Pengaman ekstra: nomor yang TIDAK boleh dibalas (pisahkan dengan koma) ---
VIP_NUMBERS=
